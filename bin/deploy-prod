#!/bin/sh

set -xe

docker compose -f docker-compose.prod.yml build
docker compose -f docker-compose.prod.yml push
ssh barmbek@drk-barmbek.de mkdir -p ekg
scp docker-compose.prod.yml barmbek@drk-barmbek.de:ekg/
ssh -t barmbek@drk-barmbek.de "cd ekg && docker compose -f docker-compose.prod.yml pull && docker compose -f docker-compose.prod.yml up -d --remove-orphans"
